# Obsidian Brain MCP Configuration
# Copy this file to .env and fill in your values

# Required: API key from Obsidian Local REST API plugin
# Get this from Obsidian Settings > Community Plugins > Local REST API > Copy API Key
OBSIDIAN_API_KEY=your_api_key_here

# Optional: Full URL override (e.g., "http://localhost:27124")
# If set, this overrides OBSIDIAN_HOST and OBSIDIAN_PORT
# Useful for custom setups, reverse proxies, or plain HTTP
# OBSIDIAN_URL=https://127.0.0.1:27124

# Optional: Obsidian API host (default: 127.0.0.1)
# Use "host.docker.internal" when running in Docker on Mac/Windows
# Ignored if OBSIDIAN_URL is set
OBSIDIAN_HOST=127.0.0.1

# Optional: Obsidian API port (default: 27124)
# Ignored if OBSIDIAN_URL is set
OBSIDIAN_PORT=27124

# Optional: Verify SSL certificate (default: false)
# The Obsidian Local REST API uses a self-signed certificate
OBSIDIAN_VERIFY_SSL=false

# Optional: Path to daily note template in vault
# DAILY_NOTE_TEMPLATE=templates/daily.md
